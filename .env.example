# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID людей, которым можно пользоваться ботом (через запятую).
# Свой ID покажет команда /id у запущенного бота.
ALLOWED_USER_IDS=

# Необязательно: ID групп, где бот отвечает всем участникам (через запятую).
# ID группы покажет команда /id, отправленная в самой группе. У групп он отрицательный.
ALLOWED_CHAT_IDS=

# Необязательно: путь к cookies.txt (YouTube с проверкой "вы не бот",
# приватные видео, Xiaohongshu)
COOKIES_FILE=
