# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID людей, которым можно писать боту в личку (через запятую).
# Свой ID можно узнать у любого бота-определителя ID, например @userinfobot.
# Сам бот команду /id в личке не отдаёт.
ALLOWED_USER_IDS=

# Telegram ID групп, где бот отвечает всем участникам (через запятую).
# ID группы отрицательный. Его покажет команда /id, отправленная в группе
# человеком, чей ID есть в ALLOWED_USER_IDS (остальным бот не отвечает).
ALLOWED_CHAT_IDS=

# Необязательно: путь к cookies.txt. Нужен только для YouTube с проверкой
# "вы не бот" и для приватных видео. Остальные сервисы работают без него.
# На Render: /etc/secrets/cookies.txt (см. README).
COOKIES_FILE=

# Необязательно: 1 - качать только с Xiaohongshu (RedNote), ссылки на X, TikTok,
# YouTube и остальное бот будет отклонять. Пусто или 0 - работают все сервисы.
ONLY_REDNOTE=
